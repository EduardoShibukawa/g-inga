  "redact": [
    {"id": "redact-nvapi", "text": "chave <<FAKE_NVAPI>> fim", "must_not_contain": "<<FAKE_NVAPI>>", "must_contain": "[REDACTED:key_nvapi]"},
    {"id": "redact-jwt", "text": "t=<<FAKE_JWT>>", "must_not_contain": "<<FAKE_JWT>>"},
    {"id": "redact-env-value", "text": "x SEGREDO-DE-TESTE-12345 y", "env_values": ["SEGREDO-DE-TESTE-12345"], "must_not_contain": "SEGREDO-DE-TESTE-12345", "must_contain": "[REDACTED:env]"},
    {"id": "redact-nothing", "text": "README.md tem 3 linhas", "must_contain": "README.md tem 3 linhas"}
  ]
}
