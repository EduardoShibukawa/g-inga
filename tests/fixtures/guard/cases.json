{
  "block": [
    {"id": "bash-cat-env", "tool": "bash", "input": {"command": "cat .env"}},
    {"id": "bash-cat-pi-auth-tilde", "tool": "bash", "input": {"command": "cat ~/.pi/agent/auth.json"}},
    {"id": "bash-cat-pi-auth-home-var", "tool": "bash", "input": {"command": "cat $HOME/.pi/agent/auth.json"}},
