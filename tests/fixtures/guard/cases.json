    {"id": "bash-head-abs-hermes-env", "tool": "bash", "input": {"command": "head -n 2 \"<<HOME>>/.hermes/profiles/pinga/.env\""}},
    {"id": "bash-rg-config", "tool": "bash", "input": {"command": "rg KEY ~/.config/opencode"}},
    {"id": "bash-cd-ssh", "tool": "bash", "input": {"command": "cd ~/.ssh && ls"}},
    {"id": "bash-env-bare", "tool": "bash", "input": {"command": "env"}},
    {"id": "bash-env-pipe", "tool": "bash", "input": {"command": "env | grep KEY"}},
    {"id": "bash-printenv", "tool": "bash", "input": {"command": "printenv"}},
    {"id": "bash-printenv-var", "tool": "bash", "input": {"command": "echo ok; printenv NVIDIA_API_KEY"}},
