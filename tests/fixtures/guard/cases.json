    {"id": "bash-bun-test", "tool": "bash", "input": {"command": "bun test tests/unit/guard.test.ts"}},
    {"id": "bash-env-run-cmd", "tool": "bash", "input": {"command": "env FOO=1 bun test"}},
    {"id": "bash-set-e", "tool": "bash", "input": {"command": "set -e; echo ok"}},
    {"id": "bash-git-status", "tool": "bash", "input": {"command": "git status --short"}},
    {"id": "bash-cat-env-example", "tool": "bash", "input": {"command": "cat .env.example"}},
    {"id": "bash-rg-process-env", "tool": "bash", "input": {"command": "rg \"process.env\" src/"}},
    {"id": "bash-rg-dotenv", "tool": "bash", "input": {"command": "rg dotenv src package.json"}},
    {"id": "bash-cat-fixture-auth-inside-cwd", "tool": "bash", "input": {"command": "cat tests/fixtures/auth.json"}},
    {"id": "bash-cat-etc-hosts", "tool": "bash", "input": {"command": "cat /etc/hosts"}},
    {"id": "read-readme", "tool": "read", "input": {"path": "README.md"}},
    {"id": "read-src-env-ts", "tool": "read", "input": {"path": "src/env.ts"}},
    {"id": "read-doc-environment", "tool": "read", "input": {"path": "docs/environment.md"}},
    {"id": "read-env-example", "tool": "read", "input": {"path": ".env.example"}},
    {"id": "read-fixture-auth-inside-cwd", "tool": "read", "input": {"filePath": "tests/fixtures/auth.json"}},
    {"id": "read-home-projetos", "tool": "read", "input": {"path": "<<HOME>>/Projetos/duh-homelab/README.md"}},
    {"id": "write-readme-mentions-env", "tool": "write", "input": {"path": "README.md", "content": "Copie .env.example para .env e preencha a chave."}},
    {"id": "grep-src", "tool": "grep", "input": {"pattern": "auth", "path": "src"}},
    {"id": "hermes-terminal-ls", "tool": "terminal", "input": {"command": "ls src"}}
